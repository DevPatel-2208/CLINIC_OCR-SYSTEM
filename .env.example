# ClinicOCR — Environment Variables

# MongoDB
MONGODB_URI=mongodb://localhost:27017/clinicocr

# JWT
JWT_SECRET=your-jwt-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# AI — Groq (primary, powerful & fast) — get key at https://console.groq.com/keys
GROQ_API_KEY=gsk_your-groq-api-key
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TEMPERATURE=0.3
GROQ_MAX_TOKENS=4096
# Fallback Gemini AI (optional)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-1.5-pro
GEMINI_TEMPERATURE=0.3
GEMINI_MAX_OUTPUT_TOKENS=4096

# Cloud Storage (Cloudinary)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Python AI Service
PYTHON_AI_SERVICE_URL=http://localhost:8000
# Comma-separated browser origins permitted to call the API (CORS)
CLIENT_URL=http://localhost:5173

# Public origin of the backend as reachable from the browser, used to build
# absolute image URLs. On Render set e.g. PUBLIC_URL=https://clinicocr.onrender.com
PUBLIC_URL=

# Server
PORT=5000
NODE_ENV=development
COOKIE_SECURE=false
